# Copy to .env (server secrets) and .env.local (local-machine overrides,
# gitignored) and fill with real values. NEVER commit .env or .env.local.
#
# Admin accounts (email + bcrypt-hashed password) live in the `admins` table
# now, not in env vars — see server/routes/adminAuth.ts.

# --- Server only (NOT prefixed with VITE_, never sent to the browser) ---
# Local Postgres connection string, e.g.:
# postgres://postgres:<password>@localhost:5000/yjpara
DATABASE_URL=
SMTP_PASS=
