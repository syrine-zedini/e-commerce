# Copy to .env (server secrets) and .env.local (local-machine overrides,
# gitignored) and fill with real values. NEVER commit .env or .env.local.
#
# Admin accounts (email + bcrypt-hashed password) live in the `admins` table
# now, not in env vars — see server/routes/adminAuth.ts.

# --- Server only (NOT prefixed with VITE_, never sent to the browser) ---
# Local Postgres connection string, e.g.:
# postgres://postgres:<password>@localhost:5000/yjpara
DATABASE_URL=
SMTP_PASS=

# --- Cloudinary (persistent image storage for production) ---
# Required on hosts with an ephemeral filesystem (Render, Netlify, …).
# When configured, uploaded images go to Cloudinary instead of local disk.
# From the Cloudinary dashboard: Settings > API Keys.
#
# Option A — the single string Cloudinary gives you:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Option B — the 3 values separately:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
