	{
		if(!$('#carousel-3059131496').parents('.tab-pane').hasClass('active'))
		{
			var width_owl_active_tab = $('#carousel-3059131496').parents('.tab-pane').siblings('.active').find('.owl-carousel').width();		
			$('#carousel-3059131496').width(width_owl_active_tab);
		}
	}
	$('#carousel-3059131496').imagesLoaded( function() {
		$('#carousel-3059131496').owlCarousel({
			items :				3,
			itemsDesktop :		[1200,3],
			itemsDesktopSmall :	[992,3],
			itemsTablet :		[768,3],
			itemsMobile :		[576,2],
			itemsCustom :		false,
			singleItem :		false,       // true : show only 1 item
			itemsScaleUp :		false,
			slideSpeed :200,        //  change speed when drag and drop a item
			paginationSpeed :	800,       // change speed when go next page
			autoplay :			false,       // time to show each item
			 loop:true,
			stopOnHover :		false,
			nav :		true,
			navText :	['<i class="fa fa-chevron-left"></i>', '<i class="fa fa-chevron-right"></i>'],
			scrollPerPage :		false,
			pagination :		false,       // show bullist
			paginationNumbers :	false,       // show number
	
			responsiveRefreshRate :	0,
			lazyLoad :			false,
			lazyFollow :		false,       // true : go to page 7th and load all images page 1...7. false : go to page 7th and load only images of page 7th
			lazyEffect :		"fade",
			autoHeight :		false,
			mouseDrag :			true,
			touchDrag :			true,
			addClassActive :	true,
			direction:			false,
			afterInit:			OwlLoaded,
			afterAction :		SetOwlCarouselFirstLast,
			dots:false,
			responsive : {
    0 : {
  items:2
    },
    480 : {
    items:2
    },
     768 : {
    items:3    },   992 : {
    items:	3    },
},
		});
	});
});
function OwlLoaded(el){
	el.removeClass('owl-loading').addClass('owl-loaded').parents('.owl-row').addClass('hide-loading');
	if ($(el).parents('.tab-pane').length && !$(el).parents('.tab-pane').hasClass('active'))
		el.width('100%');
};

